# Allow-list: ignore everything, then unignore exactly what may be committed.
# Adding a file? Add its !path line here too ("nothing to commit" = missing line).
*

# Unignore directories (needed to traverse into them)
!.github/
!.github/actions/
!.github/actions/tunnel-ssh/
!.github/workflows/
!docs/
!host/
!host/deploy-keys/
!infra/
!spawner/
!tests/
!tests/vm/
!tests/vm/bin/

# Unignore specific files
!.github/actions/tunnel-ssh/action.yml
!.github/workflows/backup.yml
!.github/workflows/ci.yml
!.github/workflows/deploy.yml
