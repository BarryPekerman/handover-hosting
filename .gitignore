# Python
__pycache__/
*.pyc
# Runtime state / anything secret (never commit tunnel creds or session state)
*.json
.handover-sessions.json
cert.pem
*credentials*

# host-only secrets (Turnstile, etc.) - never commit
*.env
handover-spawner.env

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
infra/terraform.tfvars
