# Copy to terraform.tfvars and fill in. OCIDs are identifiers, not secrets, but
# terraform.tfvars is git-ignored anyway. Fill in with the values for the
# tenancy that hosts the game VM (region defaults to il-jerusalem-1).

compartment_ocid    = "ocid1.tenancy.oc1..aaaaEXAMPLE"
availability_domain = "EXMP:IL-JERUSALEM-1-AD-1"
subnet_ocid         = "ocid1.subnet.oc1.il-jerusalem-1.aaaaEXAMPLE"
vcn_ocid            = "ocid1.vcn.oc1.il-jerusalem-1.amaaEXAMPLE"
securitylist_ocid   = "ocid1.securitylist.oc1.il-jerusalem-1.aaaaEXAMPLE"
ssh_public_key_path = "~/.ssh/handover.pub"
# oci_profile / region / shape / ocpus / memory_gbs default correctly in variables.tf
