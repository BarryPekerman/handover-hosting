[Unit]
Description=The Handover spawner (per-player Incus containers + browser terminal)
After=network-online.target incus.service
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/spawner.py
Restart=on-failure
RestartSec=2
# tuning (override as needed)
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=8080
Environment=MAX_PLAYERS=20
Environment=IDLE_MIN=240
Environment=MAX_LIFETIME_MIN=1440
# Turnstile sitekey is public, safe in git. The secret goes in the env file
# below (host-only, git-ignored); the leading '-' means "optional, don't fail
# if absent" so the service still starts before the secret is placed.
Environment=TURNSTILE_SITEKEY=0x4AAAAAAFYDIEkAlY8LK_O4
EnvironmentFile=-/home/ubuntu/handover-spawner.env

[Install]
WantedBy=multi-user.target
