# Copy to terraform.tfvars (git-ignored) and fill in.
tenancy_ocid         = "ocid1.tenancy.oc1..<...>"
oci_profile          = "DEFAULT"          # an admin's ~/.oci/config profile
region               = "il-jerusalem-1"   # the tenancy's home region
tf_user_email        = "you+tf-handover@example.com"
images_ci_user_email = "you+handover-images-ci@example.com"
